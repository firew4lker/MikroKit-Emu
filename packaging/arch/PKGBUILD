# Maintainer: firew4lker
pkgname=mikrokit-emu
pkgver=0.1.3
pkgrel=1
pkgdesc="Emulator of the Micro Design Mikrokit 8085 trainer (keypad, 7-segment display, terminal, tape, LCD)"
arch=('x86_64')
license=('GPL-3.0-or-later')
url='https://github.com/firew4lker/MikroKit-Emu'
depends=(
  'gcc-libs' 'glibc'
  'libxkbcommon' 'wayland'                                       # Wayland
  'libx11' 'libxcursor' 'libxrandr' 'libxi' 'libxkbcommon-x11'   # X11
  'vulkan-icd-loader' 'libglvnd'                                 # Vulkan, or OpenGL
  'dbus' 'xdg-desktop-portal'                                    # file dialogs
  'hicolor-icon-theme'
)
makedepends=('cargo')
optdepends=(
  'xdg-desktop-portal-gtk: file dialogs on desktops without their own portal'
)
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ecee2fcc521b0fd214d9b8e691be2745a693e9271551181d947c93044518ea80')

prepare() {
  cd "MikroKit-Emu-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "MikroKit-Emu-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "MikroKit-Emu-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "MikroKit-Emu-$pkgver"
  install -Dm755 target/release/mikrokit-emu "$pkgdir/usr/bin/mikrokit-emu"
  install -Dm644 assets/mikrokit-emu.desktop "$pkgdir/usr/share/applications/mikrokit-emu.desktop"
  for s in 16 24 32 48 64 128 256; do
    install -Dm644 "assets/icon-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/mikrokit-emu.png"
  done
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 docs/manual-en.pdf docs/manual-el.pdf docs/manual-en.html docs/manual-el.html \
    -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 examples/* -t "$pkgdir/usr/share/$pkgname/examples"
}
